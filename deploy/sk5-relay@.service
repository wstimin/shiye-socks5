[Unit]
Description=sk5 panel host relay %i
After=network-online.target sk5-proxy@%i.service
Requires=sk5-proxy@%i.service

[Service]
Type=simple
ExecStart=/usr/local/libexec/sk5-panel-helper proxy relay %i
Restart=on-failure
RestartSec=3
LimitNOFILE=1048576
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/var/lib/sk5-panel/runtime

[Install]
WantedBy=multi-user.target
