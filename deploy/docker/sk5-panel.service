[Unit]
Description=sk5 panel container
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
EnvironmentFile=/etc/sk5-panel/service.env
ExecStartPre=-/usr/bin/docker rm -f sk5-panel
ExecStart=/usr/bin/docker run --name sk5-panel --rm --network host --pid host --privileged --env-file /etc/sk5-panel/panel.env --volume /var/lib/sk5-panel:/var/lib/sk5-panel:rw $SK5_PANEL_IMAGE
ExecStop=/usr/bin/docker stop --time 30 sk5-panel
Restart=always
RestartSec=5
TimeoutStartSec=0
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
